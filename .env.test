# ── Local test config ──────────────────────────────────────────────────────
# Seed: python scripts/seed_databricks.py (requires DATABRICKS_HOST/TOKEN below)
# Use:  cp .env.test .env

# ── Coder model (Ollama) ────────────────────────────────────────────────────
CODER_MODEL=ollama_chat/qwen2.5-coder:14b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# ── Agent bounds ─────────────────────────────────────────────────────────────
MAX_STEPS=6
AGENT_STEP_TIMEOUT_S=180

# ── Databricks Connect ───────────────────────────────────────────────────────
# Fill in with your free-tier workspace before running against real data —
# tests/test_qa.py's Databricks smoke test skips automatically without these.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

# ── MCP Server ────────────────────────────────────────────────────────────────
SEED_TABLE=sample_sales

# ── Prompt Validation ─────────────────────────────────────────────────────────
MAX_MESSAGE_LEN=2000
MAX_PROMPT_TOKENS=2048
