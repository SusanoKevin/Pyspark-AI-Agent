# ── Local test data ───────────────────────────────────────────────────────────
# Seed: python scripts/seed_data.py
# Use:  cp .env.test .env

# ── Model ─────────────────────────────────────────────────────────────────────
MODEL=qwen2.5:14b
AT_RISK_THRESHOLD=75.0

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_APP_NAME=pyspark-ai-agent
DATA_PATH=./data

# ── Schema / Domain Config ────────────────────────────────────────────────────
PRIMARY_TABLE=records
METRIC_COLUMN=status
POSITIVE_VALUE=active
DATE_COLUMN=date
ENTITY_COLUMN=entity_id
ENTITY_NAME_COLUMN=entity_name
GROUP_COLUMNS=segment,category

# ── RAG / Vector Store ────────────────────────────────────────────────────────
CHROMA_PATH=.chroma
EMBED_MODEL=nomic-embed-text
DOCS_PATH=docs

# ── MCP Server ────────────────────────────────────────────────────────────────
MCP_USER_ID=mcp_user

# ── Web API ───────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-not-for-production
ADMIN_PASSWORD=admin123

# ── Prompt Validation ─────────────────────────────────────────────────────────
MAX_MESSAGE_LEN=2000
MAX_PROMPT_TOKENS=2048
