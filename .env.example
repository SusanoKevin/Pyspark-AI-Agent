# ── Coder model (Ollama) ──────────────────────────────────────────────────
# Ollama must be running locally (http://localhost:11434) with the coder
# model pulled: ollama pull qwen2.5-coder:14b-instruct-q4_K_M
CODER_MODEL=ollama_chat/qwen2.5-coder:14b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# ── Agent bounds ──────────────────────────────────────────────────────────
# Databricks Free Edition has a per-account fair-use quota — keep the
# write→run→fix self-repair loop bounded.
MAX_STEPS=6
AGENT_STEP_TIMEOUT_S=180

# ── Databricks Connect ────────────────────────────────────────────────────
# Workspace URL and a personal access token (or leave unset to fall back to
# ~/.databrickscfg profile-based auth).
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<personal-access-token>
# Unity Catalog catalog/schema the agent introspects and queries against.
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=default

# ── MCP Server ────────────────────────────────────────────────────────────
SEED_TABLE=sample_sales

# ── Prompt Validation ─────────────────────────────────────────────────────
# Maximum length (chars) of a single task description
MAX_MESSAGE_LEN=2000
# Maximum estimated tokens (task text) before rejection
MAX_PROMPT_TOKENS=2048
